PORT=3000

# tracker.delivery API
TRACKER_API_URL=https://apis.tracker.delivery/graphql
TRACKER_CLIENT_ID=your_client_id
TRACKER_CLIENT_SECRET=your_client_secret
# credential 발급일 (21일마다 갱신 필요).
# 최초 1회만 의미 있음 — 이후에는 키가 바뀐 날을 서버가 스스로 기록한다(credential_state.json).
TRACKER_CREDENTIAL_ISSUED_AT=2026-03-17

# 17TRACK API (해외 택배사 조회). 미설정 시 해외 택배 기능만 비활성.
# 대시보드 Settings 에서 발급. 신규 계정 무료 200건.
TRACK17_API_KEY=your_17track_api_key

# APNs (Apple Push Notification service)
APNS_KEY_ID=your_key_id
APNS_TEAM_ID=your_team_id
APNS_KEY_PATH=./certs/AuthKey.p8
APNS_BUNDLE_ID=com.sangjin.waito

# 서버 공개 주소 — webhook 콜백과 만료 알림 메일의 갱신 버튼이 이 주소를 쓴다.
# ⚠️ 자리표시자(your-server.com)를 그대로 두면 운영 주소로 자동 대체된다. 도메인이 생기면 그 값으로 교체.
WEBHOOK_BASE_URL=http://158.247.223.154:3001

# 관리자 페이지 접근 비밀값 — credential 갱신·강제 푸시가 이 값 하나로 열린다. 반드시 바꿀 것.
ADMIN_SECRET=your-admin-secret-here
